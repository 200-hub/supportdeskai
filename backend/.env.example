# ==============================================================================
# SupportDeskAI Backend Configuration Environment Template
# Copy this file to .env and adjust variables for your local or cloud setup.
# DO NOT COMMIT SENSITIVE SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# Application & Environment
PROJECT_NAME="SupportDeskAI Backend"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=False
API_V1_STR="/api/v1"

# Security & JWT Auth
# Generate a secure key in production via: openssl rand -hex 32
SECRET_KEY="replace_with_a_cryptographically_secure_random_key_min_32_chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cloud Database Configuration (PostgreSQL)
# e.g., Render, Railway, Supabase, Neon, AWS RDS:
# DATABASE_URL="postgresql+asyncpg://user:password@cloud-postgres-host:5432/supportdesk_db"
DATABASE_URL=""

# Local PostgreSQL Connection Settings (used only when DATABASE_URL is not set)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="supportdesk"
POSTGRES_PASSWORD="supportdesk_password"
POSTGRES_DB="supportdesk_db"

# AI Provider Configuration (Options: "openai", "gemini", "anthropic", or "mock")
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL="gemini-1.5-flash"

# Webhook Security (HMAC-SHA256 Signing Secrets)
# In production, missing secrets cause inbound webhook endpoints to return 503.
WHATSAPP_WEBHOOK_SECRET="replace_with_meta_app_secret_or_verify_token"
EMAIL_WEBHOOK_SECRET="replace_with_mailgun_signing_key_or_shared_hmac_secret"

# Rate Limiting & Proxy Configuration
# Set TRUST_PROXY_HEADERS to true ONLY when running behind a trusted reverse proxy (e.g., Nginx, ALB, Cloudflare)
TRUST_PROXY_HEADERS=false

# CORS Configuration
# For production, specify your mobile app scheme / domains, e.g. ["https://myapp.com"]
BACKEND_CORS_ORIGINS=["*"]
